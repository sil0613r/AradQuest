# Copy to api/.env for local development. On Railway, set these as service variables.

# PostgreSQL with PostGIS, for example the local Docker database from the setup guide.
DATABASE_URL=postgresql://aradquest:aradquest@localhost:5432/arad_quest

# Long random string that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Sites allowed to call this API with cookies (comma-separated, exact origins, no "*").
ALLOWED_ORIGINS=http://localhost:5173

# true on HTTPS deployments, false for local http
COOKIE_SECURE=false
