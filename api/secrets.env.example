# Copy to api/secrets.env. Use real values. DB_PASSWORD must equal database/secrets.env.
DB_PASSWORD=change-me
# A long random string, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# The Railway database (PostGIS). Copy it from the Railway PostGIS service: DATABASE_PUBLIC_URL.
# Local runs use the public URL; the services on Railway use the private one.
DATABASE_URL=postgresql://postgres:change-me@host:port/railway

# Shared with ai_bot/backend (INTERNAL_TOKEN). Same value on both services.
BOT_INTERNAL_TOKEN=change-me
