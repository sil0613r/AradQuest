server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Game API (login, register, session). Same origin as the site, so the login cookie is
    # first-party and works in browsers that block third-party cookies.
    # The browser calls /api/auth/login and nginx forwards it to ${API_UPSTREAM}/auth/login.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build files never change, so they can be cached for a long time.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths (for example /adventures/nature) return index.html,
    # and React Router handles them in the browser.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
