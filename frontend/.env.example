# Copy to .env for local development. Vite reads these at BUILD time.
# On Railway, set the variables listed in the setup guide on each service and redeploy.

# Quest Assistant backend (ai_bot/backend), including /api/bot, no trailing slash.
VITE_CHATBOT_API_URL=http://localhost:8000/api/bot

# Game API (api/) for login, register and session. Local dev calls it directly.
VITE_API_URL=http://localhost:8001

# Use the real API above. Set to true only to log in with the fake in-browser accounts.
VITE_USE_MOCK_AUTH=false
